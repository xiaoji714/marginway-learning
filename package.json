{
  "name": "marginway-learning",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm run build && pnpm run typecheck:built",
    "test": "pnpm run build && vitest run",
    "test:coverage": "pnpm run build && pnpm run coverage:built",
    "check": "tsx scripts/check.ts",
    "doc-sync": "tsx scripts/doc-sync.ts",
    "package": "pnpm run build && pnpm run package:built",
    "install:local": "tsx scripts/install.ts",
    "ci": "pnpm run version:check && pnpm run build && pnpm run typecheck:built && pnpm run coverage:built && pnpm run runtime-coverage:built && pnpm run check && pnpm run test:packages && pnpm run doc-sync && pnpm run package:built && pnpm run test:release",
    "postinstall": "tsx scripts/install-hooks.ts",
    "test:skills": "pnpm run build && vitest run scripts/test/skill.spec.ts scripts/test/skill-tasks.spec.ts",
    "test:release": "tsx scripts/smoke-release.ts",
    "version:check": "tsx scripts/version.ts check",
    "version:set": "tsx scripts/version.ts set",
    "typecheck:built": "pnpm -r typecheck && tsc --noEmit",
    "coverage:built": "vitest run --coverage && tsx scripts/verify-coverage.ts",
    "package:built": "tsx scripts/package.ts",
    "test:packages": "tsx scripts/verify-package-tests.ts",
    "test:runtime-coverage": "pnpm run build && tsx scripts/runtime-coverage.ts",
    "test:runtime-report": "pnpm run build && tsx scripts/runtime-coverage.ts --report-only",
    "test:browser": "playwright test",
    "runtime-coverage:built": "tsx scripts/runtime-coverage.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "fflate": "^0.8.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.1.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.5.3",
    "tsx": "^4.20.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
